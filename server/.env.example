# Word Pairing Backend — Environment Configuration
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Server port (default: 3001)
PORT=3001

# Node environment: development | production
NODE_ENV=development

# Google Cloud Authentication — Application Default Credentials (ADC)
#
# NO JSON KEY FILE NEEDED. The server uses ADC which automatically discovers
# credentials from the highest-priority source available:
#
#   Priority 1: GOOGLE_APPLICATION_CREDENTIALS env var (path to a JSON key file)
#   Priority 2: gcloud auth application-default login session
#   Priority 3: Workload Identity Federation (GKE, Cloud Run, etc.)
#
# Setup with service account impersonation (recommended):
#   gcloud auth application-default login --impersonate-service-account=play-integrity@YOUR_PROJECT.iam.gserviceaccount.com
#
# Or, if you must use a key file (less secure):
#   GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
#
# No GOOGLE_SERVICE_ACCOUNT_JSON variable is needed.