{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "../__tests__", "../components", "../services", "../plugins", "../compose", "../mcp-server", "../build-pipeline-mcp-server", "../App.tsx", "../index.tsx", "../types.ts", "../vite.config.ts", "../vitest.config.ts"]
}