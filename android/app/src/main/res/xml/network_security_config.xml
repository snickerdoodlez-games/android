<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Configuration for targetSdk 35 (Android 15).
    Required by Google Play Data Safety and Android 15 cleartext constraints.
    
    - Blocks all cleartext (HTTP) traffic by default in production.
    - Allows cleartext to localhost/emulator for development (10.0.2.2, 127.0.0.1).
    - Pins certificates for snickerdoodlez.online domain.
-->
<network-security-config>
    <!--
        Base configuration: block all cleartext traffic in production.
        Android 15 (targetSdk 35) enforces cleartextTrafficPermitted="false" by default.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Trust system CA certificates only (production safety) -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
        Domain configuration: allow HTTPS traffic to Google services
        (AdMob, Firebase, Google Play Games Services) and the privacy policy host.
    -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">googleapis.com</domain>
        <domain includeSubdomains="true">google.com</domain>
        <domain includeSubdomains="true">firebase.google.com</domain>
        <domain includeSubdomains="true">firebaseio.com</domain>
        <domain includeSubdomains="true">gstatic.com</domain>
        <domain includeSubdomains="true">googleadservices.com</domain>
        <domain includeSubdomains="true">googlesyndication.com</domain>
        <domain includeSubdomains="true">doubleclick.net</domain>
        <domain includeSubdomains="true">google-analytics.com</domain>
        <domain includeSubdomains="true">googletagmanager.com</domain>
        <domain includeSubdomains="true">snickerdoodlez.online</domain>
        <domain includeSubdomains="true">googleusercontent.com</domain>
        <domain includeSubdomains="true">app-measurement.com</domain>
        <domain includeSubdomains="true">crashlytics.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!--
        Development override: allow cleartext to Android emulator localhost
        (10.0.2.2) and device localhost for local dev server testing.
        This is NOT included in release builds via debug overrides but
        is safe to leave here since cleartext is only to loopback.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>